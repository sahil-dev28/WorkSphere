{
  "name": "server",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/app.ts --outfile server",
    "backfill-phone": "tsx src/scripts/backfillPhone.ts",
    "dev": "tsx watch src/app.ts",
    "seed": "tsx src/scripts/seed.ts",
    "start": "node dist/app.mjs"
  },
  "dependencies": {
    "@WorkSphere/env": "workspace:*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "catalog:",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.3",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@WorkSphere/config": "workspace:*",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.14",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.5",
    "typescript": "catalog:"
  }
}
